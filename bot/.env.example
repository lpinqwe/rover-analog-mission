# Copy — .env (secrets NOT committed!)
# The same bot that ships the APK can also be the controller:
BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN
# Limit to one chat (optional): 663450648
ROVER_CHAT_ID=663450648
# HiveMQ Cloud broker (this rover)
BROKER_URL=wss://YOUR_BROKER:8884/mqtt
MQTT_USER=REPLACE_WITH_YOUR_USER
MQTT_PASS=REPLACE_WITH_YOUR_PASSWORD
# Rover ID (topic prefix rover/<id>/...)
ROVER_ID=demo
